{
  "name": "@voxpane/windows-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Native Windows addon for voxpane: follows the SynthV window and locates the piano-roll canvas through UI Automation.",
  "main": "index.js",
  "types": "index.d.ts",
  "os": [
    "win32"
  ],
  "napi": {
    "binaryName": "windows-helper",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2"
  }
}
