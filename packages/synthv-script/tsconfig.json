{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["lua-types/5.4"],
    "noEmit": false,
    "outDir": "out"
  },
  "tstl": {
    "luaTarget": "5.4",
    "luaBundle": "overlay-bridge.lua",
    "luaBundleEntry": "src/lua/overlay-bridge.ts",
    "sourceMapTraceback": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
