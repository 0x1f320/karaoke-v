{
  "name": "@karaoke-v/app",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + React app (hello world).",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "dev": "pnpm rebuild:native && electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "pnpm rebuild:native && electron ."
  },
  "dependencies": {
    "@karaoke-v/macos-helper": "workspace:*",
    "@karaoke-v/windows-helper": "workspace:*",
    "lucide-react": "^1.28.0",
    "pixi.js": "^8.19.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^20.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^41.0.0",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.0.0"
  }
}
